# LLM provider used by every AI module (test generator, failure analyzer,
# compliance checker, RAGAS evaluation). Values: anthropic | gemini
# Switching providers only requires changing this line; keep both keys below.
LLM_PROVIDER=anthropic

# Anthropic Claude API key, used when LLM_PROVIDER=anthropic
# (get one at https://console.anthropic.com/)
ANTHROPIC_API_KEY=your-anthropic-api-key-here
# Optional: Claude model override (default claude-opus-5-5)
# CLAUDE_MODEL=claude-haiku-5-5

# Google Gemini API key, used when LLM_PROVIDER=gemini
# (free tier key: https://aistudio.google.com/apikey)
GEMINI_API_KEY=your-gemini-api-key-here
# Optional: Gemini model override (default gemini-3.8-flash)
# GEMINI_MODEL=gemini-3.8-flash

# ChromaDB (RAG vector store)
# CHROMA_HOST no longer used: the vector store runs in-memory
CHROMA_COLLECTION=banking-requirements

# Application under test
BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:3000/api

# Test credentials (do not commit real values)
TEST_USERNAME=
TEST_PASSWORD=
